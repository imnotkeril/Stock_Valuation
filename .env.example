# Copy to .env (repository root or StockAnalysisSystem/) and fill in as needed.
# Every key is optional: the app works with Yahoo Finance alone.

# Alpha Vantage — fallback for prices, company overview and symbol search
# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep — reserved for future use
FINANCIAL_MODELING_PREP_API_KEY=

# Set to 1 to never call external APIs (only cached data is used)
STOCK_ANALYSIS_OFFLINE=0
