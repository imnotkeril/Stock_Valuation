# Copy to .env (repository root or StockAnalysisSystem/) and fill in as needed.
# Every key is optional: the app works with Yahoo Finance alone.

# Alpha Vantage — fallback for prices, company overview and symbol search
# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub (free key at finnhub.io) - company news, peers, metrics on the News tab
# Alpha Vantage NEWS_SENTIMENT is a premium endpoint; with a free key the News tab uses Finnhub only.
FINNHUB_API_KEY=

# Financial Modeling Prep - recent M&A announcements on Valuation > Precedents
# Free FMP plan returns the latest 5 announcements.
FINANCIAL_MODELING_PREP_API_KEY=

# Set to 1 to never call external APIs (only cached data is used)
STOCK_ANALYSIS_OFFLINE=0

# SEC EDGAR (free): SEC requires your own contact in the User-Agent, e.g. "Your Name you@yourdomain.com"
SEC_EDGAR_USER_AGENT=

# Optional: fix the risk-free rate in percent (e.g. 4.5) instead of the live FRED 10-year yield (DGS10)
# STOCK_ANALYSIS_RISK_FREE_RATE=4.5
